# ==============================================================================
# EaseInn Root .gitignore
# ==============================================================================

# --- Personal & Sensitive Data ---
sample adhar/
sample-adhar/
sample_adhar/
sample adhar*

# --- Reference Repositories ---
iitr-reference/

# --- Environment & Secret Keys ---
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!*.env.example
*.pem
*.key
*.keystore
*.jks
key.properties

# --- Dependencies & Package Managers ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Web & Node Build Artifacts ---
dist/
dist-ssr/
.next/
out/
.turbo/
.cache/
coverage/

# --- OCR Server Runtime Data & Cached Models ---
processed/
ocr-server/uploads/*
!ocr-server/uploads/.gitkeep
ocr-server/processed/*
!ocr-server/processed/.gitkeep
*.traineddata

# --- WhatsApp Web Session Credentials (Private) ---
.wwebjs_auth/
.wwebjs_cache/
.baileys_auth/
**/.wwebjs_auth/
**/.wwebjs_cache/
**/.baileys_auth/
ocr-server/data/
**/data/whatsapp_logs.json

# --- Flutter / Dart Build & Tooling ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
app.*.symbols
app.*.map.json
**/doc/api/
migrate_working_dir/

# --- Android Artifacts (Flutter & Native) ---
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/.cxx/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# --- iOS & macOS Artifacts (Flutter & Native) ---
**/ios/Flutter/.last_build_id
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/

# --- Linux & Windows Flutter Ephemeral ---
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# --- Python Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# --- IDEs & Code Editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
logs/
*.log
