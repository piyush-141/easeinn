{
  "name": "document-verification-api",
  "version": "1.0.0",
  "description": "Backend API for document upload, processing, and identity verification",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore uploads/ --ignore processed/ --ignore test-images/ --watch src --watch server.js server.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js"
    ],
    "ignore": [
      "uploads/*",
      "processed/*",
      "test-images/*",
      ".wwebjs_auth/*",
      ".wwebjs_cache/*",
      "data/*",
      "*.log"
    ],
    "ext": "js,mjs,cjs,json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "uuid": "^10.0.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
